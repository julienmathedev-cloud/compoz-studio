{
  "version": "1.0.0",
  "name": "compoz-studio",
  "description": "",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @compoz/studio --filter @compoz/site dev",
    "dev:studio": "pnpm --filter @compoz/studio dev",
    "dev:site": "pnpm --filter @compoz/site dev",
    "db:generate": "pnpm --filter @compoz/infra db:generate",
    "db:validate": "pnpm --filter @compoz/infra db:validate",
    "build": "pnpm build:studio && pnpm build:site",
    "build:studio": "pnpm --filter @compoz/studio build",
    "build:site": "pnpm --filter @compoz/site build",
    "start": "pnpm -r --parallel --filter @compoz/studio --filter @compoz/site start",
    "start:studio": "pnpm --filter @compoz/studio start",
    "start:site": "pnpm --filter @compoz/site start",
    "lint": "pnpm -r --if-present lint",
    "lint:strict": "pnpm -r --if-present lint:strict",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm lint:strict && pnpm typecheck && pnpm build",
    "check:i18n": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/check-i18n.ts",
    "backup:upstash": "pnpm --filter @compoz/infra backup:upstash"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@compoz/infra": "workspace:*",
    "@types/node": "^20.19.35",
    "@types/sanitize-html": "^2.16.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.1.6",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "sanitize-html": "^2.17.1",
    "sharp": "^0.34.5",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
