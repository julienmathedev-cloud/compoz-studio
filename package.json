    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.1.6",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "sanitize-html": "^2.17.1",
