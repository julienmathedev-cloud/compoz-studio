{
  "name": "@compoz/infra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "migrate:default-to-demo": "tsx src/scripts/migrate-default-to-demo.ts",
    "backup:upstash": "tsx src/scripts/backup-upstash-local.ts",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@compoz/core": "workspace:*",
    "@compoz/http": "workspace:*",
    "@compoz/validation": "workspace:*",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@upstash/redis": "^1.36.3",
    "@vercel/blob": "^2.3.1",
    "bcryptjs": "^3.0.3",
    "pg": "^8.22.0",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./prisma/generated": {
      "types": "./src/prisma/generated/client.ts",
      "import": "./src/prisma/generated/client.ts",
      "default": "./src/prisma/generated/client.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/pg": "^8.20.0",
    "prisma": "7.8.0"
  }
}
