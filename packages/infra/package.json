{
  "name": "@compoz/infra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "lint": "eslint .",
    "migrate:default-to-demo": "tsx src/scripts/migrate-default-to-demo.ts",
    "backup:upstash": "tsx src/scripts/backup-upstash-local.ts",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@compoz/core": "workspace:*",
    "@prisma/client": "^7.8.0",
    "@upstash/redis": "^1.36.3",
    "@vercel/blob": "^2.3.1",
    "bcryptjs": "^3.0.3",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./kv/kv-telemetry": {
      "types": "./src/kv/kv-telemetry.ts",
      "default": "./src/kv/kv-telemetry.ts"
    },
    "./prisma/prisma-client": {
      "types": "./src/prisma/prisma-client.ts",
      "default": "./src/prisma/prisma-client.ts"
    }
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "prisma": "^7.8.0"
  }
}
